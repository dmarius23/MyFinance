# ============================================================================
# MyFinance — PRODUCTION environment (Hetzner VM).
# Copy to  deploy/.env  ON THE SERVER and fill in real values.
# deploy/.env is gitignored — NEVER commit the filled-in file.
# Consumed by docker-compose.prod.yml (backend + worker via env_file; caddy via interpolation).
# ============================================================================

# ---- Public hostnames (sslip.io for now; swap to your real domain later) ----
APP_HOST=REPLACE_IP.sslip.io           # frontend host, e.g. 203.0.113.10.sslip.io
API_HOST=api.REPLACE_IP.sslip.io       # backend host,  e.g. api.203.0.113.10.sslip.io
ACME_EMAIL=you@example.com             # Let's Encrypt account email

# ---- Images (CD sets/pins these; pin to a :SHA to roll back) ----------------
BACKEND_IMAGE=ghcr.io/dmarius23/myfinance-backend:latest
FRONTEND_IMAGE=ghcr.io/dmarius23/myfinance-frontend:latest

# ---- Database — Supabase Postgres (EU) --------------------------------------
# CRITICAL: use the SESSION-mode connection (direct or Supavisor "session", port 5432).
# Do NOT use the transaction pooler (port 6543): it does not preserve the per-request
# session GUCs (app.tenant_id / app.role) and would BREAK row-level security.
# App role (RLS-subject; created by supabase/create_app_role.sql):
DB_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
DB_APP_USER=myfinance_app
DB_APP_PASSWORD=CHANGE_ME_STRONG_PASSWORD          # same value as in create_app_role.sql
# Admin role for Flyway DDL (the Supabase 'postgres' role):
DB_ADMIN_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# ---- Auth — Supabase --------------------------------------------------------
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_JWKS_URI=https://PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY    # SECRET: user invites + Supabase Storage
# SUPABASE_ISSUER=                                 # optional; blank = derived from JWKS_URI

# ---- CORS (must exactly match the frontend origin) --------------------------
CORS_ALLOWED_ORIGINS=https://REPLACE_IP.sslip.io

# ---- Redis (self-hosted container) ------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Document storage — Supabase Storage ------------------------------------
STORAGE_TYPE=supabase
STORAGE_SUPABASE_BUCKET=documents

# ---- Email — SMTP (EU provider: Brevo / Mailjet / Scaleway) ------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_AUTH=true
SMTP_STARTTLS=true

# ---- Rate limiting (shared across web + worker via Redis) -------------------
RATELIMIT_ENABLED=true
RATELIMIT_DISTRIBUTED=true

# ---- Outbox (async; the worker drains it) — keep inline OFF -----------------
OUTBOX_INLINE=false

# ---- Receipt OCR (optional; blank = disabled, images stay NEEDS_REVIEW) ------
# Pilot: leave disabled, or use Anthropic direct. Bedrock EU is the later EU-residency path.
# ANTHROPIC_API_KEY=
# RECEIPT_PROVIDER=anthropic

# ---- PDF OCR fallback (Tesseract is baked into the backend image) -----------
MYFINANCE_OCR_ENABLED=true

# ---- Web Push (VAPID) — generate once: npx web-push generate-vapid-keys ------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Google Drive ingestion (service account) -------------------------------
MYFINANCE_INGESTION_GOOGLE_CLIENT_EMAIL=myfinance-drive@PROJECT.iam.gserviceaccount.com
# Single line; keep the literal \n escapes inside the PEM (the app converts them to newlines):
MYFINANCE_INGESTION_GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
MYFINANCE_INGESTION_POLL_ENABLED=true

# ---- WhatsApp — OFF for the pilot (prod sender is Meta-locked) ---------------
MYFINANCE_WHATSAPP_PROVIDER=logging

# NOTE: do NOT set SPRING_PROFILES_ACTIVE here. Prod runs the default profile; the worker
# container sets SPRING_PROFILES_ACTIVE=worker itself. Never set it to "local" (loads dev seed).
